{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mob-hub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "mob-hub.com",
      "custom_domain": true
    },
    {
      "pattern": "www.mob-hub.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
