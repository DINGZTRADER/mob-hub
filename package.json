{
  "name": "mob-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "cloudflare:prepare": "npm install --no-save --package-lock=false @opennextjs/cloudflare@1.20.2 wrangler@4.125.0",
    "cloudflare:build": "npm run cloudflare:prepare && opennextjs-cloudflare build",
    "preview": "npm run cloudflare:prepare && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run cloudflare:prepare && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "npm run cloudflare:prepare && wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "16.2.12",
    "postcss": "8.5.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.6.2"
}